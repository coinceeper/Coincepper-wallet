<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1510"
   version = "1.3">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Prepare Flutter Framework Script"
               scriptText = "# Direct FLUTTER_ROOT resolution for scheme pre-action.\n# Pre-actions have limited build-setting access, so we resolve the path explicitly.\nFLUTTER_ROOT=\"\"\n\n# 1. Try Generated.xcconfig first (most reliable)\nif [ -f &quot;${SRCROOT}/Flutter/Generated.xcconfig&quot; ]; then\n  FLUTTER_ROOT=$(grep &#39;^FLUTTER_ROOT=&#39; &quot;${SRCROOT}/Flutter/Generated.xcconfig&quot; 2&gt;/dev/null | head -1 | cut -d= -f2)\nfi\n\n# 2. Try ephemeral env file\nif [ -z &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -f &quot;${SRCROOT}/Flutter/ephemeral/flutter_export_environment.sh&quot; ]; then\n  . &quot;${SRCROOT}/Flutter/ephemeral/flutter_export_environment.sh&quot; 2&gt;/dev/null\nfi\nif [ -z &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -f &quot;${SRCROOT}/Flutter/flutter_export_environment.sh&quot; ]; then\n  . &quot;${SRCROOT}/Flutter/flutter_export_environment.sh&quot; 2&gt;/dev/null\nfi\n\n# 3. Hardcoded fallback for this machine\nif [ -z &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -x &quot;/opt/homebrew/share/flutter/packages/flutter_tools/bin/xcode_backend.sh&quot; ]; then\n  FLUTTER_ROOT=\"/opt/homebrew/share/flutter\"\nfi\n\n# Run prepare\nif [ -n &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -x &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; ]; then\n  /bin/sh &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; prepare\nelse\n  echo &quot;warning: [Flutter] Could not resolve FLUTTER_ROOT to a valid xcode_backend.sh.&quot;\nfi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "97C146ED1CF9000F007C117D"
                     BuildableName = "Runner.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
